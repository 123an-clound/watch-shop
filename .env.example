# Public site URL (no trailing slash) — used for canonical URLs, sitemap, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Never expose to the client. (secret key "sb_secret_..." or legacy service_role JWT)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Optional — order confirmation email (Resend). Leave empty to disable.
RESEND_API_KEY=
ORDER_EMAIL_FROM=

# Optional — Cloudflare Turnstile on checkout. Leave both empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
